# Application
APP_NAME=ShopRAG
APP_VERSION=0.1.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://shoprag:shoprag@db:5432/shoprag

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=similar_products

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Price Update Settings
PRICE_UPDATE_MARGIN=0.05

# Search
MAX_SEARCH_RESULTS=5

# Admin Panel Security
SECRET_KEY=change-me-in-production-use-a-strong-random-key
